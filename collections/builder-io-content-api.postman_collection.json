  "item": [
    {
      "id": "dc55f78e-6a34-401b-aeba-1909c9dfcab1",
      "name": "Content",
      "description": {
        "content": "Retrieve and query published content entries from Builder.io models.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6c7b82de-f7e5-4f58-aa58-7f53b99cdc0c",
          "name": "Query content entries by model",
          "request": {
            "name": "Query content entries by model",
            "description": {
              "content": "Retrieves published content entries for a given model name. Supports MongoDB-style query filters, user attribute targeting, locale, pagination, and field selection. Results are sorted by priority by default.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "content",
                ":model"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apiKey",
                  "value": "<string>",
                  "description": "(Required) Your public Builder.io API key."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of results to return. Maximum value is 100."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of results to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "MongoDB-style JSON query filter applied to content fields. Example: {\"data.slug\":{\"$eq\":\"my-page\"}}"
                },
                {
                  "disabled": false,
                  "key": "userAttributes",
                  "value": "<string>",
                  "description": "JSON object of user attributes used for targeting and personalization. Example: {\"urlPath\":\"/about\",\"country\":\"US\"}"
                },
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "The current page URL used for targeting by urlPath. Used as a shorthand for setting userAttributes.urlPath."
                },
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "<string>",
                  "description": "The locale code for localized content retrieval (e.g., \"en-US\")."
                },
                {
                  "disabled": false,
                  "key": "enrich",
                  "value": "false",
                  "description": "When true, enriches references and Symbol blocks with their full content data instead of returning only IDs."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-separated list of fields to include in the response. Reduces payload size by returning only specified fields."
                },
                {
                  "disabled": false,
                  "key": "includeRefs",
                  "value": "false",
                  "description": "When true, includes referenced content objects inline."
                },
                {
                  "disabled": false,
                  "key": "cacheSeconds",
                  "value": "<integer>",
                  "description": "Override the CDN cache duration in seconds."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "model",
                  "description": "(Required) The name of the Builder.io content model to query."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
